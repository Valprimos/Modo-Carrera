{
  "name": "fm-career-manager",
  "version": "0.1.0",
  "description": "Modo Carrera de entrenador de fútbol - juego de gestión estilo Football Manager",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"npm:build:electron:watch\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/write-electron-package-json.cjs",
    "build:electron:watch": "tsc -p electron/tsconfig.json --watch",
    "postbuild:electron:watch": "node scripts/write-electron-package-json.cjs",
    "build": "tsc -b && vite build && npm run build:electron",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "eslint": "^8.57.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "wait-on": "^8.0.0"
  }
}
